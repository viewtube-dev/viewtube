Subject: [PATCH 12/12] studio-controls: restore 2.5:1 bar tokens and 50%-white
 empty fill after stash; fix measured-count mocks

---
 scripts/audit/studio-control-parity.test.mjs         |  2 +-
 src/studio-ui/primitives/StudioValueToggles.test.tsx | 10 +++++-----
 src/styles/studio-control-distill-overrides.css      | 11 ++++++-----
 src/styles/studio-control-system.css                 |  4 ++--
 4 files changed, 14 insertions(+), 13 deletions(-)

diff --git a/scripts/audit/studio-control-parity.test.mjs b/scripts/audit/studio-control-parity.test.mjs
index 47dd58bb3..dab303abc 100644
--- a/scripts/audit/studio-control-parity.test.mjs
+++ b/scripts/audit/studio-control-parity.test.mjs
@@ -84,7 +84,7 @@ test("bar toggle uses adaptive width counts, proportional fill, and size-specifi
   assert.match(overrides, /--vt-bar-width:\s*10px/);
   assert.match(overrides, /--vt-bar-gap:\s*3px/);
   assert.match(overrides, /border:\s*0\s*!important/);
-  assert.match(overrides, /background:\s*color-mix\(in srgb,[\s\S]*?50%,\s*transparent\)\s*!important/);
+  assert.match(overrides, /background:\s*color-mix\(in srgb,[\s\S]*?50%\)[\s\S]*?!important/);
   assert.match(overrides, /\.vt-studio-value-toggle__bar\[data-active="true"\][\s\S]*?background:\s*#000/);
 });
 
diff --git a/src/studio-ui/primitives/StudioValueToggles.test.tsx b/src/studio-ui/primitives/StudioValueToggles.test.tsx
index 4717c5c6e..4184bea71 100644

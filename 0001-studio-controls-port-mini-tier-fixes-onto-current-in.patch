+  color: #000;
+  font: inherit;
+  caret-color: var(--vt-stepper-primary);
+  outline: none;
+  box-shadow: inset 0 0 0 var(--vt-stepper-stroke) var(--vt-stepper-primary);
+  text-align: center;
+  appearance: textfield;
+}
+.vt-studio-inline-stepper__value::-webkit-outer-spin-button,
+.vt-studio-inline-stepper__value::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
+.vt-studio-split-stepper-value {
+  box-sizing: border-box;
+  flex: 1 1 auto;
+  width: 100%;
+  min-width: 0;
+  height: 100%;
+  margin: 0;
+  padding: 0 14px;
+  border: 0;
+  border-radius: 0;
+  background: color-mix(in srgb, var(--vt-stepper-primary) var(--vt-studio-control-default-fill-opacity, 50%), transparent);
+  color: #000;
+  font: inherit;
+  caret-color: var(--vt-stepper-primary);

+  --vt-stepper-stroke: var(--vt-studio-control-stroke, 3px);
+  box-shadow: none;
+}
+.vt-studio-inline-stepper__actions {
+  display: grid;
+  grid-template-rows: repeat(2, minmax(0, 1fr));
+  flex: 0 0 var(--vt-studio-control-height, 44px);
+  width: var(--vt-studio-control-height, 44px);
+}
+.vt-studio-inline-stepper__rail {
+  display: grid;
+  place-items: center;
+  width: 100%;
+  height: 100%;
+  min-height: 0;
+  padding: 0;
+  border: 0;
+  background: var(--vt-stepper-secondary);
+  color: #000;
+  cursor: pointer;
+}
+.vt-studio-inline-stepper__rail:first-child { border-bottom: var(--vt-stepper-stroke) solid #000; }
+.vt-studio-inline-stepper__rail:focus-visible { outline: 3px solid var(--vt-stepper-secondary); outline-offset: -3px; z-index: 1; }
+.vt-studio-inline-stepper__value {
+  box-sizing: border-box;
+  flex: 1 1 auto;
+  width: 100%;
+  min-width: 0;
+  height: 100%;
+  margin: 0;
+  padding: 0 8px;
+  border: 0;

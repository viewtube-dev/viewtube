+  min-width: 0;
+  border-left: var(--vt-stepper-stroke) solid #000;
+  background: var(--vt-stepper-secondary);
+}
+.vt-studio-split-stepper-actions {
+  position: relative;
+  display: grid;
+  grid-template-rows: repeat(2, minmax(0, 1fr));
+  width: 100%;
+  height: 100%;
+}
+.vt-studio-split-stepper-actions button {
+  display: grid;

From e5abaf790a6de7b73db47cdc9d82197ac8c42c47 Mon Sep 17 00:00:00 2001
From: Studio Controls Bot <bot@viewtube.dev>
Date: Sat, 24 Oct 2026 05:36:39 +0000
Subject: [PATCH 08/12] studio-controls: assert the canonical editable-field
 focus contract in the parity audit

---
 scripts/audit/studio-control-parity.test.mjs | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/scripts/audit/studio-control-parity.test.mjs b/scripts/audit/studio-control-parity.test.mjs
index d3bc135ac..47dd58bb3 100644
--- a/scripts/audit/studio-control-parity.test.mjs
+++ b/scripts/audit/studio-control-parity.test.mjs
@@ -45,8 +45,8 @@ test("input and textarea focus retain the canonical editable-field stroke tokens
   assert.match(css, /--vt-field-text-stroke-focus:\s*var\(--vt-field-text-focus\)/);
   assert.match(css, /--vt-field-text-focus:\s*#000/);
   assert.match(css, /--vt-field-caret-focus:\s*var\(--vt-field-primary\)/);
-  assert.match(fields, /input\[data-vt-studio-control="true"\][\s\S]*?:focus[\s\S]*?-webkit-text-stroke-color:\s*var\(--vt-field-primary/);
-  assert.match(fields, /textarea\[data-vt-studio-control="true"\][\s\S]*?:focus[\s\S]*?-webkit-text-stroke-color:\s*var\(--vt-field-primary/);
+  // Editable input/textarea focus rules: black focused text AND black focused
+  // glyph stroke (the canonical 2026-10 contract), with the caret kept primary.
   // A read-only StudioTextBox has its own display-copy focus rule; do not
   // confuse that rule with the editable input/textarea focus contract.
   const editableFocusRules = fields
@@ -54,7 +54,8 @@ test("input and textarea focus retain the canonical editable-field stroke tokens
     .filter((rule) => /(?:input|textarea)\[data-vt-studio-control="true"\]/.test(rule) && /:focus/.test(rule))
     .join("}");
   assert.ok(editableFocusRules.length > 0, "editable field focus rules must be present");
-  assert.doesNotMatch(editableFocusRules, /-webkit-text-stroke-color:\s*#000\s*!important/);
+  assert.match(editableFocusRules, /-webkit-text-stroke-color:\s*(?:var\(--vt-field-text-stroke-focus\)|#000)/);
+  assert.match(editableFocusRules, /color:\s*(?:var\(--vt-field-text-focus\)|#000)/);
 });
 
 test("floating-label risen typography uses one shared token pair while rest labels retain field-size tokens", () => {

+  --vt-stepper-primary: var(--vt-studio-control-accent, var(--pair-a, #36e0f6));
+  --vt-stepper-secondary: var(--vt-studio-control-secondary, var(--pair-b, #ff7f6b));
+  --vt-stepper-stroke: var(--vt-studio-control-stroke, 3px);
+  border: var(--vt-stepper-stroke) solid #000;
+  border-radius: var(--vt-studio-control-radius, 6px);
+  overflow: hidden;
+  background: var(--vt-stepper-secondary);
+}
+.vt-studio-split-stepper input.vt-studio-split-stepper-value {
+  box-sizing: border-box;
+  width: 100%;
+  min-width: 0;
+  height: 100%;
+  margin: 0;
+  padding: 0 14px;
+  border: 0;
+  border-radius: 0;
+  background: color-mix(in srgb, var(--vt-stepper-primary) var(--vt-studio-control-default-fill-opacity, 50%), transparent);
+  color: #000;
+  font: inherit;
+  caret-color: var(--vt-stepper-primary);
+  outline: none;
+  appearance: textfield;
+}
+.vt-studio-split-stepper input.vt-studio-split-stepper-value::-webkit-outer-spin-button,
+.vt-studio-split-stepper input.vt-studio-split-stepper-value::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
+[data-vt-studio-control="true"][data-vt-studio-split="right"].vt-studio-split-stepper { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
+[data-vt-studio-control="true"][data-vt-studio-split="right"].vt-studio-split-stepper > [data-vt-studio-split-rail].vt-studio-split-stepper-rail {
+  border-left: var(--vt-stepper-stroke) solid #000;
+  background: var(--vt-stepper-secondary);
+}
+.vt-studio-split-stepper-actions {
+  position: relative;
+  display: grid;
+  grid-template-rows: repeat(2, minmax(0, 1fr));
+  width: 100%;
+  height: 100%;
+}
+.vt-studio-split-stepper-actions button {
+  display: grid;
+  place-items: center;
+  width: 100%;
+  min-width: 0;
+  min-height: 0;
+  padding: 0;
+  border: 0;
+  background: var(--vt-stepper-secondary);
+  color: #000;
+  cursor: pointer;
+  touch-action: none;
+}
+.vt-studio-split-stepper-actions button:first-child { border-bottom: var(--vt-stepper-stroke) solid #000; }
+.vt-studio-split-stepper-actions button:focus-visible { outline: 3px solid var(--vt-stepper-secondary); outline-offset: -3px; z-index: 1; }
+.vt-studio-split-stepper-actions button:disabled { opacity: .4; cursor: not-allowed; }
+html body [data-vt-studio-control="true"][data-vt-studio-split="right"].vt-studio-split-stepper {
+  grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) !important;
+}
+html body .vt-studio-split-stepper .vt-studio-split-stepper-actions > button:first-child {
+  border-bottom: var(--vt-stepper-stroke, 3px) solid #000 !important;
+}
+.vt-studio-inline-stepper {
+  --vt-inline-stepper-side: var(--vt-studio-control-height, 44px);
+  grid-template-columns: var(--vt-inline-stepper-side) minmax(40px, 1fr) var(--vt-inline-stepper-side);
+}
+[data-vt-studio-control="true"][data-vt-studio-split="double"].vt-studio-inline-stepper { display: grid; }
+.vt-studio-inline-stepper__value {
+  box-sizing: border-box;
+  width: 100%;
+  min-width: 0;
+  height: 100%;
+  margin: 0;
+  padding: 0 8px;
+  border: 0;
+  background: color-mix(in srgb, var(--vt-stepper-primary, var(--pair-a, #36e0f6)) var(--vt-studio-control-default-fill-opacity, 50%), transparent);
+  color: #000;
+  font: inherit;
+  outline: none;
+  text-align: center;
+}
+.vt-studio-inline-stepper__rail {
+  display: grid;
+  place-items: center;
+  width: 100%;
+  height: 100%;
+  padding: 0;
+  border: 0;
+  background: var(--vt-stepper-secondary, var(--pair-b, #ff7f6b));
+  color: #000;
+  cursor: pointer;
+}
+
+/* Side-counter rail glyphs use the dedicated small chevron preset. */
+.vt-studio-side-counter__actions button svg {
+  display: block;
+  flex: 0 0 auto;
+  width: 14px;
+  height: 14px;
+  max-width: 100%;
+  max-height: 100%;
+  stroke-width: 3.75;
+}
+
+/* Paired counter specimens top-align inside their centered per-size rows. */
+.vt-confirmed-counter-pair { justify-content: center; align-items: flex-start; }

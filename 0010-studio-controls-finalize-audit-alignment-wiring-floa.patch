+assert.ok(!/textarea[^{}]*\{/.test(css));
+assert.ok(!css.includes(".vt-studio-floating-field-label") && !css.includes(".vt-studio-fixed-field-label"));
 
 function nativeInputFontSizeRules(stylesheet) {
   return [...stylesheet.matchAll(/([^{}]+)\{([^{}]*)\}/g)]

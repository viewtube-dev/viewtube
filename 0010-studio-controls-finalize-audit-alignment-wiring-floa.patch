   assert.match(component, /max = 100/);
   assert.match(component, /accelerationEase/);
-  assert.match(component, /accelerationProgress = Math\.min\(1, elapsed \/ 720\)/);
+  assert.match(component, /accelerationProgress = Math\.min\(1, elapsed \/ 520\)/);
   assert.match(component, /boundaryEase/);
   assert.match(component, /remainingSteps/);
   assert.match(styles, /touch-action:\s*none/);
diff --git a/scripts/audit/studio-floating-input-typography.test.mjs b/scripts/audit/studio-floating-input-typography.test.mjs
index 445aaa48a..a396f7fc9 100644

// Canonical Studio stepper implementations are owned by this module.
export interface StudioInlineStepperProps extends Omit<React.HTMLAttributes<HTMLDivElement>, "onChange"> {
  value: number
  onValueChange: (value: number) => void
  min?: number
  max?: number
  step?: number
  size?: StudioControlSize
  disabled?: boolean
  ariaLabel?: string
}

/** Clamp a numeric step action to valid finite values and the supplied bounds. */
export function normalizeStudioInlineStepperValue(
  value: number,
  direction: -1 | 0 | 1,
  step = 1,
  min = -Infinity,
  max = Infinity,
): number {
  const safeStep = Number.isFinite(step) && step > 0 ? step : 1
  const base = Number.isFinite(value) ? value : Number.isFinite(min) ? min : 0
  const lower = Number.isFinite(min) ? min : -Infinity
  const upper = Number.isFinite(max) ? max : Infinity
  if (lower > upper) return Number.isFinite(min) ? min : 0
  const next = base + direction * safeStep
  if (!Number.isFinite(next)) return direction < 0 && Number.isFinite(min) ? min : direction > 0 && Number.isFinite(max) ? max : base
  const precision = Math.min(12, Math.max(String(base).split(".")[1]?.length ?? 0, String(safeStep).split(".")[1]?.length ?? 0))
  const rounded = Number(next.toFixed(precision))
  return Math.min(upper, Math.max(lower, rounded))
}

/**
 * Canonical horizontal Studio Controls stepper: square decrement button,
 * editable numeric field, square increment button. Independent from SubToolbox.
 */
export const StudioInlineStepper: React.FC<StudioInlineStepperProps> = ({
  value,
  onValueChange,
  min = -Infinity,
  max = Infinity,
  step = 1,
  size = "standard",
  disabled = false,
  ariaLabel = "Value",
  className,
  style,
  ...props
}) => {
  const [draft, setDraft] = React.useState(String(Number.isFinite(value) ? value : 0))
  const [focused, setFocused] = React.useState(false)
  const validBounds = min <= max
  const safeStep = Number.isFinite(step) && step > 0 ? step : 1

  React.useEffect(() => {
    if (!focused) setDraft(String(Number.isFinite(value) ? value : 0))
  }, [value, focused])

  const commit = React.useCallback(() => {
    const parsed = draft.trim() === "" ? Number.NaN : Number(draft)
    if (!Number.isFinite(parsed)) {
      setDraft(String(Number.isFinite(value) ? value : 0))
      return
    }
    const normalized = normalizeStudioInlineStepperValue(parsed, 0, safeStep, min, max)
    setDraft(String(normalized))
    if (normalized !== value) onValueChange(normalized)
  }, [draft, max, min, onValueChange, safeStep, value])

  const adjust = React.useCallback((direction: -1 | 1) => {
    const parsedDraft = draft.trim() === "" ? Number.NaN : Number(draft)
    const base = Number.isFinite(parsedDraft) ? parsedDraft : value
    const next = normalizeStudioInlineStepperValue(base, direction, safeStep, min, max)
    setDraft(String(next))
    if (next !== value) onValueChange(next)
  }, [draft, max, min, onValueChange, safeStep, value])

  const currentForBounds = Number.isFinite(value) ? value : 0

  return (
    <div
      {...props}
      className={["vt-studio-inline-stepper", `is-${size}`, focused ? "is-focused" : "", className].filter(Boolean).join(" ")}
      data-vt-studio-control="true"
      data-vt-studio-control-family="stepper"
      data-vt-studio-control-kind="inline-stepper"
      data-vt-studio-username-foundation="true"
      data-size={size}
      role="group"
      aria-label={ariaLabel}
      style={style}
    >
      <StudioSplitLeftButton icon={<Minus aria-hidden="true" focusable="false" />} iconSizeVariant="moderate" sizeVariant={size}
        className="vt-studio-inline-stepper__button vt-studio-inline-stepper__decrement"
        aria-label={`Decrease ${ariaLabel}`} disabled={disabled || !validBounds || currentForBounds <= min}
        onClick={() => adjust(-1)} />
      <StudioUsernameInput
        icon={<span />}
        sizeVariant={size === "compact" ? "compact" : "standard"}
        className="vt-studio-inline-stepper__field-shell"
        inputClassName="vt-studio-inline-stepper__value"
        type="number"
        inputMode="decimal"
        aria-label={ariaLabel}
        value={draft}
        min={Number.isFinite(min) ? min : undefined}
        max={Number.isFinite(max) ? max : undefined}
        step={safeStep}
        disabled={disabled || !validBounds}
        onFocus={() => setFocused(true)}
        onBlur={() => { setFocused(false); commit() }}
        onChange={event => {
          const nextDraft = event.currentTarget.value
          setDraft(nextDraft)
          if (!nextDraft.trim()) return
          const parsed = Number(nextDraft)
          if (!Number.isFinite(parsed)) return
          onValueChange(normalizeStudioInlineStepperValue(parsed, 0, safeStep, min, max))
        }}
        onKeyDown={event => {
          if (event.key === "Enter") {
            event.preventDefault()
            commit()
            event.currentTarget.blur()
          }
        }}
      />
      <StudioSplitLeftButton icon={<Plus aria-hidden="true" focusable="false" />} iconSizeVariant="moderate" sizeVariant={size}
        className="vt-studio-inline-stepper__button vt-studio-inline-stepper__increment"
        aria-label={`Increase ${ariaLabel}`} disabled={disabled || !validBounds || currentForBounds >= max}
        onClick={() => adjust(1)} />
    </div>
  )
}

StudioInlineStepper.displayName = "StudioInlineStepper"

export type StudioSplitStepperSize = "standard" | "compact"
export interface StudioSplitStepperProps extends Omit<React.HTMLAttributes<HTMLDivElement>, "onChange"> {
  value: number
  onValueChange: (value: number) => void
  min?: number
  max?: number
  step?: number
  size?: StudioSplitStepperSize
  disabled?: boolean
  ariaLabel?: string
}

/** Studio Controls stepper family: fixed 2:1 editable value pane and square split-action rail. */
export const StudioSplitStepper: React.FC<StudioSplitStepperProps> = ({
  value, onValueChange, min = -Infinity, max = Infinity, step = 1,
  size = "standard", disabled = false, ariaLabel = "Value",
  className, style, ...props
}) => {
  const valueRef = React.useRef(value)
  valueRef.current = value
  const [draft, setDraft] = React.useState(String(value))
  const [inputFocused, setInputFocused] = React.useState(false)
  const [holding, setHolding] = React.useState(false)
  const holdTimer = React.useRef<ReturnType<typeof setTimeout> | null>(null)
  const repeatTimer = React.useRef<ReturnType<typeof setTimeout> | null>(null)
  const startedAt = React.useRef(0)
  const heldDirection = React.useRef<-1 | 1>(1)
  const scheduleRepeatRef = React.useRef<() => void>(() => {})

  React.useEffect(() => { if (!inputFocused) setDraft(String(value)) }, [value, inputFocused])

  const stopHold = React.useCallback(() => {
    if (holdTimer.current) clearTimeout(holdTimer.current)
    if (repeatTimer.current) clearTimeout(repeatTimer.current)
    holdTimer.current = null
    repeatTimer.current = null
    setHolding(false)
  }, [])
  React.useEffect(() => stopHold, [stopHold])

  const validBounds = min <= max
  const safeStep = Number.isFinite(step) && step > 0 ? step : 1

  const change = React.useCallback((direction: -1 | 1) => {
    const current = valueRef.current
    const next = normalizeStudioInlineStepperValue(current, direction, safeStep, min, max)
    if (next === current) { stopHold(); return }
    valueRef.current = next
    setDraft(String(next))
    onValueChange(next)
  }, [max, min, onValueChange, safeStep, stopHold])

  const scheduleRepeat = React.useCallback(() => {
    const elapsed = Date.now() - startedAt.current
    const delay = elapsed > 1800 ? 32 : elapsed > 1100 ? 58 : elapsed > 500 ? 105 : 220
    repeatTimer.current = setTimeout(() => {
      const current = valueRef.current
      if ((heldDirection.current > 0 && current >= max) || (heldDirection.current < 0 && current <= min)) {
        stopHold()
        return
      }
      change(heldDirection.current)
      if ((heldDirection.current > 0 && valueRef.current < max) || (heldDirection.current < 0 && valueRef.current > min)) scheduleRepeatRef.current()
      else stopHold()
    }, delay)
  }, [change, max, min, stopHold])
  React.useEffect(() => { scheduleRepeatRef.current = scheduleRepeat }, [scheduleRepeat])

  const beginHold = (direction: -1 | 1, event: React.PointerEvent<HTMLButtonElement>) => {
    if (disabled || !validBounds || event.button !== 0) return
    if ((direction > 0 && valueRef.current >= max) || (direction < 0 && valueRef.current <= min)) return
    event.preventDefault()
    stopHold()
    heldDirection.current = direction
    startedAt.current = Date.now()
    change(direction)
    holdTimer.current = setTimeout(() => {
      setHolding(true)
      scheduleRepeat()
    }, 320)
  }

  const commitDraft = () => {
    const parsed = draft.trim() === "" ? Number.NaN : Number(draft)
    if (!Number.isFinite(parsed) || !validBounds) { setDraft(String(valueRef.current)); return }
    const normalized = normalizeStudioInlineStepperValue(parsed, 0, safeStep, min, max)
    valueRef.current = normalized
    setDraft(String(normalized))
    if (normalized !== value) onValueChange(normalized)
  }

  return (
    <div
      {...props}
      className={["vt-studio-split-stepper", `is-${size}`, inputFocused || holding ? "is-interacting" : "", className].filter(Boolean).join(" ")}
      data-vt-studio-control="true"
      data-vt-studio-control-family="stepper"
      data-vt-studio-control-kind="split-stepper"
      data-vt-studio-username-foundation="true"
      data-size={size}
      role="group"
      aria-label={ariaLabel}
      style={style}
    >
      <StudioUsernameInput
        icon={<span />}
        sizeVariant={size === "compact" ? "compact" : "standard"}
        className="vt-studio-split-stepper__field-shell"
        inputClassName="vt-studio-split-stepper-value"
        type="number"
        aria-label={ariaLabel}
        inputMode="decimal"
        value={draft}
        min={Number.isFinite(min) ? min : undefined}
        max={Number.isFinite(max) ? max : undefined}
        step={safeStep}
        disabled={disabled || !validBounds}
        onFocus={() => setInputFocused(true)}
        onBlur={() => { setInputFocused(false); commitDraft() }}
        onChange={(event) => {
          const nextDraft = event.currentTarget.value
          setDraft(nextDraft)
          if (!nextDraft.trim()) return
          const parsed = Number(nextDraft)
          if (!Number.isFinite(parsed)) return
          if (!validBounds) return
          const normalized = normalizeStudioInlineStepperValue(parsed, 0, safeStep, min, max)
          valueRef.current = normalized
          onValueChange(normalized)
        }}
      />
      <div className="vt-studio-split-stepper-rail">
        <StudioSplitLeftButton icon={<ChevronsUp aria-hidden="true" />} iconSizeVariant="moderate" sizeVariant={size}
          className="vt-studio-split-stepper-up" aria-label={`Increase ${ariaLabel}`}
          disabled={disabled || !validBounds || value >= max}
          onPointerDown={(event) => beginHold(1, event)}
          onPointerUp={stopHold} onPointerLeave={stopHold} onPointerCancel={stopHold} onLostPointerCapture={stopHold}
          onClick={(event) => { if (event.detail === 0 && !disabled && valueRef.current < max) change(1) }} />
        <StudioSplitLeftButton icon={<ChevronsDown aria-hidden="true" />} iconSizeVariant="moderate" sizeVariant={size}
          className="vt-studio-split-stepper-down" aria-label={`Decrease ${ariaLabel}`}
          disabled={disabled || !validBounds || value <= min}
          onPointerDown={(event) => beginHold(-1, event)}
          onPointerUp={stopHold} onPointerLeave={stopHold} onPointerCancel={stopHold} onLostPointerCapture={stopHold}
          onClick={(event) => { if (event.detail === 0 && !disabled && valueRef.current > min) change(-1) }} />
      </div>
    </div>
  )
}


/** Closeable metadata badge using the global Studio size and palette contract. */
export interface StudioCloseableBadgeProps {
  label: string;
  onClose?: () => void;
  className?: string;
  entering?: boolean;
  sizeVariant?: "standard" | "compact" | "micro";
}
export const StudioCloseableBadge: React.FC<StudioCloseableBadgeProps> = ({
  label,
  onClose,
  className,
  entering = true,
  sizeVariant = "standard",
}) => {
  const [swapping, setSwapping] = React.useState(false);
  const [fading, setFading] = React.useState(false);
  const [isEntering, setIsEntering] = React.useState(entering);
  const [removed, setRemoved] = React.useState(false);
  const busy = React.useRef(false);

  React.useEffect(() => {
    if (!isEntering) return;
    const timer = window.setTimeout(() => setIsEntering(false), 460);
    return () => window.clearTimeout(timer);
  }, [isEntering]);

  const close = () => {
    if (busy.current) return;
    busy.current = true;
    setSwapping(true);
    window.setTimeout(() => {
      setSwapping(false);
      setFading(true);
      window.setTimeout(() => { setRemoved(true); onClose?.(); }, 1000);
    }, 540);
  };

  const normalized = label.trim().toUpperCase();
  if (removed) return null;
  return (
    <span
      className={["vt-studio-closeable-badge", className].filter(Boolean).join(" ")}
      data-size={sizeVariant}
      data-vt-studio-badge="true"
      data-entering={isEntering ? "true" : undefined}
      data-fading={fading ? "true" : undefined}
    >
      <span className="vt-studio-closeable-badge__label">{normalized}</span>
      <button
        type="button"
        className="vt-studio-closeable-badge__close"
        aria-label={`Remove ${normalized || "tag"}`}
        title="Remove tag"
        data-swapping={swapping ? "true" : undefined}
        onClick={close}
      >
        <svg viewBox="0 0 12 12" aria-hidden="true">
          <line x1="2.5" y1="2.5" x2="9.5" y2="9.5" />
          <line x1="9.5" y1="2.5" x2="2.5" y2="9.5" />
        </svg>
      </button>
    </span>
  );
};
StudioCloseableBadge.displayName = "StudioCloseableBadge";

export interface StudioTagEditorProps {
  value?: readonly string[];
  defaultValue?: readonly string[];
  onChange?: (tags: string[]) => void;
  className?: string;
  ariaLabel?: string;
  placeholder?: string;
  maxTagLength?: number;
}

/** Canonical add/remove tag editor using StudioTextInput in compact mode. */
export const StudioTagEditor: React.FC<StudioTagEditorProps> = ({
  value,
  defaultValue = [],
  onChange,
  className,
  ariaLabel = "Tags",
  placeholder = "TAG NAME",
  maxTagLength = 32,
}) => {
  const [internalTags, setInternalTags] = React.useState<string[]>(() => [...defaultValue]);
  const tags = value === undefined ? internalTags : [...value];
  const [open, setOpen] = React.useState(false);
  const [draft, setDraft] = React.useState("");
  const [fly, setFly] = React.useState<{ id: number; label: string; left: number; top: number } | null>(null);
  const [flyTarget, setFlyTarget] = React.useState<{ left: number; top: number } | null>(null);
  const [flyArrived, setFlyArrived] = React.useState(false);
  const inputRef = React.useRef<HTMLInputElement>(null);
  const editorRef = React.useRef<HTMLDivElement>(null);
  const nextId = React.useRef(1);

  const commit = (next: string[]) => {
    if (value === undefined) setInternalTags(next);
    onChange?.(next);
  };
  const openComposer = () => {
    setDraft("");
    setOpen(true);
    window.requestAnimationFrame(() => inputRef.current?.focus());
  };
  const closeComposer = () => {
    setOpen(false);
    setDraft("");
  };
  const removeTag = (index: number) => commit(tags.filter((_, i) => i !== index));
  const confirmTag = () => {
    const label = draft.trim().toUpperCase().slice(0, maxTagLength);
    if (!label) {
      inputRef.current?.focus();
      return;
    }
    const inputRect = inputRef.current?.getBoundingClientRect();
    const id = nextId.current++;
    setFlyArrived(false);
    if (inputRect) {
      setFly({
        id,
        label,
        left: inputRect.left + 12,
        top: inputRect.top + (inputRect.height - 20) / 2,
      });
      setFlyTarget(null);
    }
    commit([...tags, label]);
    setDraft("");
  };

  React.useEffect(() => {
    if (!fly) return;
    const frame = window.requestAnimationFrame(() => {
      const labels = editorRef.current?.querySelectorAll<HTMLElement>(".vt-studio-closeable-badge__label");
      const target = labels?.[labels.length - 1];
      if (target) {
        const rect = target.getBoundingClientRect();
        setFlyTarget({ left: rect.left, top: rect.top });
      }
    });
    const arriveTimer = window.setTimeout(() => setFlyArrived(true), 450);
    const finishTimer = window.setTimeout(() => {
      setFly(null);
      setFlyTarget(null);
      setFlyArrived(false);
      setOpen(false);
      setDraft("");
    }, 850);
    return () => {
      window.cancelAnimationFrame(frame);
      window.clearTimeout(arriveTimer);
      window.clearTimeout(finishTimer);
    };
  }, [fly]);

  return (
    <div ref={editorRef} className={["vt-studio-tag-editor", className].filter(Boolean).join(" ")} data-vt-studio-tag-editor="true" role="group" aria-label={ariaLabel}>
      <div className="vt-studio-tag-editor__list">
        {tags.map((tag, index) => (
          <StudioCloseableBadge
            key={`${index}:${tag}`}
            label={tag}
            onClose={() => removeTag(index)}
            entering={false}
            className={fly && index === tags.length - 1 && tag === fly.label ? "is-fly-destination" : undefined}
          />
        ))}
      </div>
      {!open ? (
        <button type="button" className="vt-studio-tag-editor__square-action" data-vt-studio-control="true" data-size="compact" data-vt-studio-tag-editor-action="true" aria-label="Add tag" title="Add tag" onClick={openComposer}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><line x1="8" y1="3" x2="8" y2="13" /><line x1="3" y1="8" x2="13" y2="8" /></svg>
        </button>
      ) : (
        <div className={["vt-studio-tag-editor__composer", fly ? "is-fading" : ""].filter(Boolean).join(" ")}>
          <StudioTextInput
            ref={inputRef}
            variant="simple"
            sizeVariant="compact"
            value={draft}
            placeholder={placeholder}
            maxLength={maxTagLength}
            autoComplete="off"
            spellCheck={false}
            aria-label="New tag name"
            onChange={event => setDraft(event.target.value)}
            onKeyDown={event => {
              if (event.key === "Enter") { event.preventDefault(); confirmTag(); }
              if (event.key === "Escape") { event.preventDefault(); closeComposer(); }
            }}
          />
          <button type="button" className="vt-studio-tag-editor__square-action" data-vt-studio-control="true" data-size="compact" data-vt-studio-tag-editor-action="true" aria-label="Confirm tag" title="Confirm tag" onClick={confirmTag}>
            <svg viewBox="0 0 16 16" aria-hidden="true"><polyline points="3,8.5 6.5,12 13,4" /></svg>
          </button>
        </div>
      )}
      {fly && (
        <span
          className="vt-studio-tag-editor__fly"
          aria-hidden="true"
          data-targeted={flyTarget ? "true" : "false"}
          data-arrived={flyArrived ? "true" : "false"}
          style={{
            left: flyTarget?.left ?? fly.left,
            top: flyTarget?.top ?? fly.top,
          }}
        >
          {fly.label}
        </span>
      )}
    </div>
  );
};
StudioTagEditor.displayName = "StudioTagEditor";



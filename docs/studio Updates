/**
 * Geometry + exception contract tests (ideas #6, #16).
 * Asserts the machine-readable registry and CSS/token invariants.
 */
import { readFileSync } from "node:fs"
import { resolve } from "node:path"
import { describe, expect, it } from "vitest"
import {
  STUDIO_CONTROL_SIZE_BASE,
  STUDIO_CONTROL_EXCEPTIONS,
  STUDIO_WIDTH_POLICY,
  STUDIO_COLOR_ROLES,
  studioSizeTierToCssVars,
} from "../tokens"

const cssPath = resolve(process.cwd(), "src/styles/studio-control-system.css")
const readCss = () => readFileSync(cssPath, "utf8")

describe("size ladder (ideas #1, #14)", () => {
  it("micro is half-compact on primary geometry axes", () => {
    const { compact, micro } = STUDIO_CONTROL_SIZE_BASE
    expect(micro.height).toBe(compact.height / 2)
    expect(micro.stroke).toBe(compact.stroke / 2)
    expect(micro.radius).toBe(compact.radius / 2)
    // gap stays 4 across tiers
    expect(micro.gap).toBe(4)
    expect(compact.gap).toBe(4)
    expect(STUDIO_CONTROL_SIZE_BASE.standard.gap).toBe(4)
  })

  it("emits consistent CSS vars per tier", () => {
    const std = studioSizeTierToCssVars("standard")
    expect(std["--vt-studio-control-height"]).toBe("44px")
    expect(std["--vt-studio-control-stroke"]).toBe("3px")
    const micro = studioSizeTierToCssVars("micro")
    expect(micro["--vt-studio-control-height"]).toBe("14px")
  })
})

describe("exception registry (idea #6)", () => {
  it("names every registered exception with an owner and rationale", () => {
    for (const [id, entry] of Object.entries(STUDIO_CONTROL_EXCEPTIONS)) {
      expect(entry.id).toBe(id)
      expect(entry.owner).toBeTruthy()
      expect(entry.rationale).toBeTruthy()
    }
  })

  it("marks vault spectrum tag as content-width", () => {
    expect(STUDIO_CONTROL_EXCEPTIONS.vaultSpectrumTag.widthPolicy).toBe("content")
  })
})

describe("width policy (idea #13)", () => {
  it("defaults to row fill with an explicit content allow-list", () => {
    expect(STUDIO_WIDTH_POLICY.default).toBe("row")
    expect(STUDIO_WIDTH_POLICY.contentWidthAllowList).toContain("spectrumTag")
  })
})

describe("color roles (idea #15)", () => {
  it("exposes primary/secondary CSS variable names only", () => {
    expect(STUDIO_COLOR_ROLES.primaryVar).toBe("--vt-studio-control-accent")
    expect(STUDIO_COLOR_ROLES.secondaryVar).toBe("--vt-studio-control-secondary")
  })
})

describe("CSS geometry contract (ideas #8, #10, #12, #16)", () => {
  it("keeps Studio controls flat (no press-motion tokens in contract tail)", () => {
    const css = readCss()
    const tail = css.slice(css.lastIndexOf("/* Canonical Studio Controls contract") || 0)
    // Allow 0ms tokens; forbid active press motion wiring
    expect(css).not.toMatch(/--vt-studio-motion-press:\s*[1-9]/
    expect(css).toMatch(/box-shadow:\s*none/)
  })

  it("uses secondary for both double-split rails", () => {
    const css = readCss()
    // Prefer unified selector; legacy BEM may still exist during migration
    const hasUnified =
      css.includes('[data-vt-studio-split="double"] [data-vt-studio-split-rail]') ||
      css.includes("vt-studio-double-split-badge__rail:first-child")
    expect(hasUnified).toBe(true)
  })

  it("does not force field type with !important font-size", () => {
    const css = readCss()
    const fieldRegion = css.includes("Canonical Studio Controls contract")
      ? css.slice(css.lastIndexOf("/* Canonical Studio Controls contract"))
      : css
    expect(fieldRegion).not.toMatch(/font-size:[^;]*!important/)
  })
})

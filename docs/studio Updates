/** Derive micro from compact by ½ ratio with discrete pixel rounding (idea #14). */
function halfCompact<T extends Record<string, number | string>>(compact: T): T {
  const out = { ...compact }
  const halfKeys = [
    "height",
    "stroke",
    "radius",
    "fontSize",
    "textStroke",
    "focusOutlineWidth",
    "secondaryFocusOutlineWidth",
    "iconSize",
  ] as const
  for (const key of halfKeys) {
    if (typeof compact[key] === "number") {
      ;(out as Record<string, number | string>)[key] = Math.max(
        0.25,
        Math.round((compact[key] as number) * 50) / 100,
      )
    }
  }
  // Explicit micro typography tweaks (legibility)
  ;(out as Record<string, number | string>).fontSize = 10
  ;(out as Record<string, number | string>).iconSize = 10
  ;(out as Record<string, number | string>).iconStroke = 1.5
  ;(out as Record<string, number | string>).letterSpacing = -0.01
  ;(out as Record<string, number | string>).lineHeight = 1
  // Gap stays 4px across all tiers (idea #11)
  ;(out as Record<string, number | string>).gap = 4
  return out
}


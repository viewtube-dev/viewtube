{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "viewtube://schemas/conversation-work-log",
  "title": "ViewTube Conversation Work Log",
  "type": "object",
  "required": [
    "schemaVersion",
    "conversationId",
    "created",
    "lastEdited",
    "reviewStatus",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "viewtube.conversation-work-log.v1"
    },
    "conversationId": {
      "type": "string",
      "pattern": "^VT-CONV-"
    },
    "created": {
      "type": "string"
    },
    "lastEdited": {
      "type": "string"
    },
    "sourceHost": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewStatus": {
      "enum": [
        "UNREVIEWED",
        "REVIEWING",
        "PARTIALLY_RECONCILED",
        "RECONCILED"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "itemId",
          "title",
          "kind",
          "conversationState",
          "reviewStatus"
        ],
        "properties": {
          "itemId": {
            "type": "string",
            "pattern": "^VT-CWI-"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "details": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "FEATURE",
              "BUG",
              "INTEGRATION",
              "REFACTOR",
              "OPTIMIZATION",
              "DESIGN",
              "PLAN",
              "AUDIT",
              "REPORT",
              "DOCUMENTATION",
              "SKILL",
              "WORKFLOW",
              "PROTOTYPE",
              "STANDALONE_HTML",
              "RESEARCH",
              "REFERENCE",
              "MIGRATION",
              "VERIFICATION",
              "CLEANUP",
              "IDEA",
              "RISK",
              "DECISION"
            ]
          },
          "conversationState": {
            "enum": [
              "PLANNED",
              "STARTED",
              "PARTIAL",
              "COMPLETED_IN_CONVERSATION",
              "VERIFIED_IN_CONVERSATION",
              "BLOCKED",
              "ABANDONED",
              "DISCOVERED"
            ]
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capabilityIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "surfaces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "changedPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "branchPrRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "similarityKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "value": {
            "type": "object",
            "properties": {
              "creatorImpact": {
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH",
                  "CRITICAL"
                ]
              },
              "systemLeverage": {
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH",
                  "CRITICAL"
                ]
              },
              "urgency": {
                "enum": [
                  "NONE",
                  "LOW",
                  "MEDIUM",
                  "HIGH",
                  "CRITICAL"
                ]
              },
              "reusePotential": {
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH"
                ]
              },
              "confidence": {
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH"
                ]
              },
              "estimatedEffort": {
                "enum": [
                  "SMALL",
                  "MEDIUM",
                  "LARGE",
                  "UNKNOWN"
                ]
              },
              "implementationRisk": {
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH",
                  "UNKNOWN"
                ]
              },
              "rationale": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "relationship": {
            "enum": [
              "NEW",
              "CONTINUATION",
              "ALREADY_TRACKED",
              "DUPLICATE",
              "OVERLAPS",
              "EXPANDS",
              "SUPERSEDES",
              "BUG_IN_EXISTING",
              "VERIFICATION_ONLY",
              "COMPLETED_ALREADY",
              "DONOR_ONLY"
            ]
          },
          "suggestedDestination": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewStatus": {
            "enum": [
              "UNREVIEWED",
              "REVIEWING",
              "RECONCILED"
            ]
          },
          "disposition": {
            "enum": [
              "ALREADY_TRACKED",
              "MERGE_INTO_EXISTING_TASK",
              "CREATE_TASK_CANDIDATE",
              "UPDATE_INTEGRATED_APPLICATION_PROGRAM",
              "UPDATE_PRODUCT_ARCHITECTURE",
              "UPDATE_DOMAIN_AUTHORITY",
              "UPDATE_SPECIFICATION",
              "UPDATE_EXISTING_PLAN",
              "MERGE_PLANS",
              "CREATE_PLAN",
              "CREATE_DECISION_RECORD",
              "CREATE_OPPORTUNITY",
              "CREATE_RISK",
              "ATTACH_RECEIPT_EVIDENCE",
              "ARCHIVE_AS_DONOR",
              "NO_ACTION_REQUIRED",
              "REJECT",
              null
            ]
          },
          "targetRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "harvestedMaterial": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reviewNotes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "instructions": {
      "type": "array",
      "description": "Conversation-level user requirements; these are not canonical tasks.",
      "items": {
        "$ref": "#/$defs/instruction"
      }
    },
    "branchPrReconciliation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/branchPrReconciliation"
      }
    },
    "integrationGaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/integrationGap"
      }
    },
    "conversationName": {
      "type": "string",
      "minLength": 1
    },
    "application": {
      "type": "string",
      "minLength": 1
    },
    "sourceApplication": {
      "type": "string",
      "minLength": 1
    },
    "sourceConversationUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "targetBranch": {
      "type": [
        "string",
        "null"
      ]
    },
    "executiveSummary": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "At most ten concise sentences containing the facts required to resume the conversation."
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "instruction": {
      "type": "object",
      "required": [
        "instructionId",
        "text",
        "status"
      ],
      "properties": {
        "instructionId": {
          "type": "string",
          "pattern": "^REQ-[0-9]{3,}$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "NOT_STARTED",
            "IN_PROGRESS",
            "PARTIAL",
            "IMPLEMENTED_LOCALLY",
            "COMMITTED",
            "IN_PR",
            "MERGED",
            "VERIFIED_DELIVERED",
            "BLOCKED",
            "DEFERRED",
            "REJECTED_WITH_REASON",
            "SUPERSEDED_WITH_REFERENCE"
          ]
        },
        "relatedItemIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "branchRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pullRequests": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targetBranch": {
          "type": [
            "string",
            "null"
          ]
        },
        "deliveryState": {
          "enum": [
            "NOT_STARTED",
            "LOCAL_ONLY",
            "COMMITTED",
            "IN_PR",
            "MERGED",
            "PRESENT_ON_TARGET",
            "INTEGRATED",
            "VERIFIED",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "branchPrReconciliation": {
      "type": "object",
      "required": [
        "branch",
        "targetBranch",
        "classification"
      ],
      "properties": {
        "branch": {
          "type": "string"
        },
        "targetBranch": {
          "type": "string"
        },
        "pullRequest": {
          "type": [
            "integer",
            "null"
          ]
        },
        "openedHeadSha": {
          "type": [
            "string",
            "null"
          ]
        },
        "currentHeadSha": {
          "type": [
            "string",
            "null"
          ]
        },
        "commitsAfterPrOpen": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "postPrChangedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mergeCommitSha": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetContainsChanges": {
          "enum": [
            "YES",
            "PARTIAL",
            "NO",
            "UNKNOWN"
          ]
        },
        "classification": {
          "enum": [
            "MERGED_AND_CURRENT",
            "PARTIALLY_MERGED",
            "OPEN_PR",
            "CLOSED_UNMERGED",
            "UNMERGED_BRANCH",
            "POST_PR_WORK_REMAINS",
            "RECOVERED_IN_ANOTHER_PR",
            "SUPERSEDED",
            "ABANDONED",
            "DUPLICATE",
            "CONFLICTED",
            "BRANCH_MISSING",
            "UNKNOWN"
          ]
        },
        "recoveryDestination": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "integrationGap": {
      "type": "object",
      "required": [
        "featureId",
        "title",
        "maturity"
      ],
      "properties": {
        "featureId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "maturity": {
          "type": "object",
          "properties": {
            "architecture": {
              "enum": [
                "NONE",
                "PLANNED",
                "PARTIAL",
                "IMPLEMENTED",
                "VERIFIED",
                "NOT_APPLICABLE"
              ]
            },
            "backend": {
              "enum": [
                "NONE",
                "PLANNED",
                "PARTIAL",
                "IMPLEMENTED",
                "VERIFIED",
                "NOT_APPLICABLE"
              ]
            },
            "frontend": {
              "enum": [
                "NONE",
                "PLANNED",
                "PARTIAL",
                "IMPLEMENTED",
                "VERIFIED",
                "NOT_APPLICABLE"
              ]
            },
            "integration": {
              "enum": [
                "NONE",
                "PLANNED",
                "PARTIAL",
                "IMPLEMENTED",
                "VERIFIED",
                "NOT_APPLICABLE"
              ]
            },
            "tests": {
              "enum": [
                "NONE",
                "PLANNED",
                "PARTIAL",
                "IMPLEMENTED",
                "VERIFIED",
                "NOT_APPLICABLE"
              ]
            },
            "runtime": {
              "enum": [
                "NONE",
                "PLANNED",
                "PARTIAL",
                "IMPLEMENTED",
                "VERIFIED",
                "NOT_APPLICABLE"
              ]
            },
            "responsive": {
              "enum": [
                "NONE",
                "PLANNED",
                "PARTIAL",
                "IMPLEMENTED",
                "VERIFIED",
                "NOT_APPLICABLE"
              ]
            },
            "documentation": {
              "enum": [
                "NONE",
                "PLANNED",
                "PARTIAL",
                "IMPLEMENTED",
                "VERIFIED",
                "NOT_APPLICABLE"
              ]
            },
            "release": {
              "enum": [
                "NONE",
                "PLANNED",
                "PARTIAL",
                "IMPLEMENTED",
                "VERIFIED",
                "NOT_APPLICABLE"
              ]
            }
          },
          "required": [
            "architecture",
            "backend",
            "frontend",
            "integration",
            "tests",
            "runtime",
            "responsive",
            "documentation",
            "release"
          ],
          "additionalProperties": false
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "category",
              "description"
            ],
            "properties": {
              "category": {
                "enum": [
                  "IMPLEMENTED_BUT_UNCONNECTED",
                  "BACKEND_WITHOUT_FRONTEND",
                  "FRONTEND_WITHOUT_BACKEND",
                  "COMPONENT_WITHOUT_APPLICATION_INTEGRATION",
                  "API_WITHOUT_AUTHORIZATION",
                  "DATA_WITHOUT_PERSISTENCE",
                  "WORKFLOW_WITHOUT_FEEDBACK",
                  "TESTS_WITHOUT_RUNTIME_PROOF",
                  "DOCUMENTATION_WITHOUT_IMPLEMENTATION",
                  "RELEASE_BLOCKED",
                  "UNKNOWN"
                ]
              },
              "description": {
                "type": "string"
              },
              "userImpact": {
                "type": "string"
              },
              "dependency": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "acceptanceEvidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "document": {
      "type": "object",
      "required": [
        "title",
        "path"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "relatedItemIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  }
}

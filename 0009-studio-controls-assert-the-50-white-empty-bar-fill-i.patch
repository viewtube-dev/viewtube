From a9e39a713c00da6cc78e4aae822a213749735163 Mon Sep 17 00:00:00 2001
From: Studio Controls Bot <bot@viewtube.dev>
Date: Sat, 24 Oct 2026 05:38:20 +0000
Subject: [PATCH 09/12] studio-controls: assert the 50%-white empty-bar fill in
 the bar-toggle regression test

---
 src/studio-ui/primitives/StudioControls.test.tsx | 2 +-
 src/studio-ui/primitives/StudioControls.tsx      | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/studio-ui/primitives/StudioControls.test.tsx b/src/studio-ui/primitives/StudioControls.test.tsx
index cc166aec6..dda648816 100644
--- a/src/studio-ui/primitives/StudioControls.test.tsx
+++ b/src/studio-ui/primitives/StudioControls.test.tsx
@@ -1202,7 +1202,7 @@ describe("Studio field focus, floating labels, and toggle regressions", () => {
     expect(source).toContain("event.currentTarget.setPointerCapture?.(event.pointerId)");
     expect(source).toContain("onPointerCancel={stopRepeat}");
     expect(source).toContain("onLostPointerCapture={stopRepeat}");
-    expect(css).toContain("40%, #fff");
+    expect(css).toContain("color-mix(in srgb, #fff 50%, var(--vt-studio-control-accent, var(--pair-a, #36e0f6)) 50%)");
     expect(css).toMatch(/\.vt-studio-value-toggle__bars\s*\{[^}]*display:\s*flex/s);
     expect(css).toContain('data-active="true"');
     expect(css).toContain("pointer-events: auto;");
diff --git a/src/studio-ui/primitives/StudioControls.tsx b/src/studio-ui/primitives/StudioControls.tsx
index b83357a35..153d4d6e0 100644
--- a/src/studio-ui/primitives/StudioControls.tsx
+++ b/src/studio-ui/primitives/StudioControls.tsx
@@ -2186,7 +2186,7 @@ StudioSplitLeftDropdown.displayName = "StudioSplitLeftDropdown"
  * with one continuous ease-out curve, and smoothsteps to 75ms within the
  * final three steps after beginning boundary easing 16 steps from the bound. */
 export const getStudioCounterRepeatDelay = (elapsedMs: number, remainingSteps: number) => {
-  const accelerationProgress = Math.min(1, Math.max(0, elapsedMs / 720));
+  const accelerationProgress = Math.min(1, Math.max(0, elapsedMs / 520));
   const accelerationEase = 1 - Math.pow(1 - accelerationProgress, 2.2);
   const accelerationDelay = 150 - accelerationEase * 127;
   const boundaryProgress = Number.isFinite(remainingSteps)
-- 
